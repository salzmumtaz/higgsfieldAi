{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/agent-capture.py",
        "timeout": 20
      }
    ],
    "afterAgentResponse": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/agent-capture.py",
        "timeout": 20
      }
    ],
    "stop": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/agent-capture.py",
        "timeout": 20
      }
    ],
    "sessionEnd": [
      {
        "command": "/usr/bin/python3 .cursor/hooks/agent-capture.py",
        "timeout": 20
      }
    ]
  }
}
